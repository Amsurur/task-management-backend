# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Validated at boot by src/config (Zod); invalid/missing values fail fast.

# Runtime: development | test | production
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=3000

# Log level: fatal|error|warn|info|debug|trace|silent (optional; defaults by env)
LOG_LEVEL=debug

# PostgreSQL connection string (must start with postgres:// or postgresql://)
DATABASE_URL=postgresql://postgres:12345@localhost:5432/taskmgmt?schema=public

# JWT secrets — generate strong random values, e.g. `openssl rand -base64 48`
# Each must be at least 32 characters.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32

# Token lifetimes (JWT duration syntax: 15m, 7d, or seconds)
JWT_ACCESS_TTL=35m
JWT_REFRESH_TTL=7d

# CORS allowed origins: comma-separated list, or `*` for any
CORS_ORIGIN=*

# Public base URL of this API — used to build absolute links in emails
# (e.g. the invite magic-link). No trailing slash. Must include the scheme.
PUBLIC_BASE_URL=http://localhost:3000

# File storage (attachments). STORAGE_DRIVER: local | s3
# local -> writes to LOCAL_STORAGE_DIR on disk (dev/test default)
# s3    -> requires the S3_* values below
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
STORAGE_PRESIGN_TTL=900

# S3-compatible object store (only used when STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
# S3_BUCKET=task-management
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_FORCE_PATH_STYLE=false

# AI assistant (Google Gemini). Set GEMINI_API_KEY to enable POST /api/v1/ai/chat.
# Without it the AI endpoint returns 503; the rest of the API is unaffected.
# Get a key at https://aistudio.google.com/apikey. Model defaults to gemini-2.0-flash.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash-lite

# SMTP / email (all optional). When SMTP_HOST is set, workspace invites are
# delivered as real emails via nodemailer. If unset: dev/test print the email to
# the console; production throws (so a missing config never fails silently).
# For Gmail: enable 2-Step Verification and create an App Password for SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true only for port 465 (implicit TLS)
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="Task Management <you@gmail.com>"
